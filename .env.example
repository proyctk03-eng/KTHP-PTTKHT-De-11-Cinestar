# ========================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN MICROSERVICES (MẪU .ENV.EXAMPLE)
# HỌC PHẦN: TRIỂN KHAI VÀ QUẢN TRỊ HỆ THỐNG PHẦN MỀM - K23
# SINH VIÊN: NGUYỄN TUẤN ĐẠT - MSV: DTC245200452
# ========================================================

# 1. Cấu hình Web Application (Service: webapp)
PORT=3000
NODE_ENV=production
SESSION_SECRET=your_jwt_or_session_secret_key_here

# 2. Cấu hình Cơ sở dữ liệu MySQL (Service: db)
DB_HOST=db
DB_PORT=3306
DB_NAME=ticket_db
DB_USER=ticket_user
DB_PASSWORD=YourSecurePassword123!
MYSQL_ROOT_PASSWORD=YourRootPassword123!

# 3. Cổng Reverse Proxy & Admin GUI
HTTP_PORT=80
HTTPS_PORT=443
PMA_PORT=8080
DB_PORT_HOST=3306

# 4. Cấu hình Giám sát Prometheus & Grafana (Bước 4)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YourGrafanaPassword123!
