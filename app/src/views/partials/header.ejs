<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'CINESTAR K23 - Đặt Vé Xem Phim & Sự Kiện' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>">
</head>
<body>
    <header class="navbar">
        <div class="nav-container">
            <a href="/" class="brand-logo">
                <span class="brand-icon">🎬</span>
                <span class="brand-text">CINESTAR</span>
                <span class="brand-badge">K23 ICTU</span>
            </a>
            <ul class="nav-links">
                <li><a href="/" class="nav-item">Trang Chủ</a></li>
                <li><a href="/?type=MOVIE" class="nav-item">Phim</a></li>
                <li><a href="/?type=EVENT" class="nav-item">Sự Kiện</a></li>
                <li><a href="/history" class="nav-item">Tra Cứu Vé</a></li>
                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <% if (currentUser.role === 'ADMIN') { %>
                        <li><a href="/admin" class="nav-item" style="color: #f87171; font-weight: 700; background: rgba(239,68,68,0.15); padding: 0.25rem 0.6rem; border-radius: 9999px; border: 1px solid rgba(239,68,68,0.3);">👑 Quản Trị</a></li>
                    <% } %>
                    <li><a href="/profile" class="nav-item" style="color: var(--gold); font-weight: 600;">👤 <%= currentUser.fullname.split(' ').slice(-1)[0] %></a></li>
                    <li><a href="/logout" class="nav-item" style="color: #94a3b8; font-size: 0.85rem;">Đăng Xuất</a></li>
                <% } else { %>
                    <li><a href="/login" class="nav-item" style="color: #ffffff; font-weight: 600;">🔐 Đăng Nhập</a></li>
                    <li><a href="/register" class="nav-item" style="color: var(--gold);">Đăng Ký</a></li>
                <% } %>
                <li><a href="/health" target="_blank" class="nav-item" style="color: #10b981; font-size: 0.8rem; border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.2rem 0.6rem; border-radius: 9999px;">● API</a></li>
                <li><a href="/#movies-section" class="nav-btn">🎟️ Đặt Vé</a></li>
            </ul>
        </div>
    </header>
    <main class="main-content">
