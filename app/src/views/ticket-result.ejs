<%- include('partials/header') %>

<div style="text-align: center; margin-bottom: 2rem;">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; background: rgba(16, 185, 129, 0.15); border: 2px solid #10b981; border-radius: 50%; color: #10b981; font-size: 2rem; margin-bottom: 1rem;">
        ✓
    </div>
    <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 800; color: #ffffff;">
        Đặt Vé & Thanh Toán Thành Công!
    </h1>
    <p style="color: var(--text-muted); font-size: 1rem;">
        Cảm ơn bạn đã sử dụng dịch vụ. Dưới đây là thông tin vé điện tử của bạn:
    </p>
</div>

<!-- E-TICKET CARD -->
<div class="ticket-wrapper">
    <div class="ticket-header">
        <div>
            <div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.85;">VÉ XEM PHIM ĐIỆN TỬ (E-TICKET)</div>
            <div class="ticket-header-title">CINESTAR CINEMA K23</div>
        </div>
        <div class="ticket-code">
            <%= ticket.booking_code %>
        </div>
    </div>

    <div class="ticket-body">
        <div>
            <div class="ticket-field">
                <div class="ticket-label">Phim / Sự kiện:</div>
                <div class="ticket-value" style="color: var(--gold);"><%= ticket.movie_title %></div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="ticket-field">
                    <div class="ticket-label">Ngày chiếu:</div>
                    <div class="ticket-value"><%= ticket.formatted_date %></div>
                </div>
                <div class="ticket-field">
                    <div class="ticket-label">Suất chiếu:</div>
                    <div class="ticket-value"><%= ticket.formatted_start %></div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="ticket-field">
                    <div class="ticket-label">Phòng chiếu:</div>
                    <div class="ticket-value"><%= ticket.room_name %></div>
                </div>
                <div class="ticket-field">
                    <div class="ticket-label">Ghế đã đặt:</div>
                    <div class="ticket-value" style="color: #4ade80;">
                        <%= seatDetails.map(s => s.seat_code).join(', ') %>
                    </div>
                </div>
            </div>

            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed rgba(255, 255, 255, 0.1);">
                <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem;">
                    <span style="color: var(--text-muted);">Khách hàng:</span>
                    <strong><%= ticket.customer_name %> (<%= ticket.customer_phone %>)</strong>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem;">
                    <span style="color: var(--text-muted);">Phương thức:</span>
                    <span>Thanh toán giả lập qua <strong><%= ticket.payment_method %></strong></span>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 0.4rem;">
                    <span style="color: var(--text-muted);">Thời gian giao dịch:</span>
                    <span><%= ticket.formatted_booking_time %></span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-top: 0.75rem; font-size: 1rem;">
                    <span style="font-weight: 600;">Tổng số tiền:</span>
                    <strong style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--gold);">
                        <%= Number(ticket.total_amount).toLocaleString('vi-VN') %> đ
                    </strong>
                </div>
            </div>
        </div>

        <!-- MÃ QR QUÉT TẠI CỬA RẠP -->
        <div class="ticket-qr-box">
            <img src="<%= qrCodeUrl %>" alt="QR Code Ticket" class="ticket-qr-img">
            <div class="ticket-qr-desc">
                Quét mã QR tại cổng rạp<br>để vào xem phim
            </div>
            <div style="font-size: 0.65rem; color: #64748b; margin-top: 0.5rem; font-family: var(--font-mono);">
                <%= ticket.transaction_id %>
            </div>
        </div>
    </div>
</div>

<div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 3rem; flex-wrap: wrap;">
    <button onclick="window.print()" class="btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        🖨️ In Vé / Lưu PDF
    </button>
    <a href="/history" class="btn-secondary">
        🔍 Tra Cứu Lịch Sử Vé
    </a>
    <a href="/" class="nav-btn">
        🎬 Đặt Thêm Phim Khác
    </a>
</div>

<%- include('partials/footer') %>
