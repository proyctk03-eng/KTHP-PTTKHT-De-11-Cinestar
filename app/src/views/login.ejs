<%- include('partials/header') %>

<div style="max-width: 480px; margin: 3rem auto; background: var(--bg-card); padding: 2.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--shadow-card);">
    <div style="text-align: center; margin-bottom: 2rem;">
        <span style="font-size: 2.5rem;">🔐</span>
        <h1 style="font-family: var(--font-heading); font-size: 1.85rem; font-weight: 800; color: #ffffff; margin-top: 0.5rem;">
            Đăng Nhập Hệ Thống
        </h1>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
            Đăng nhập để đặt vé rạp, quản lý vé và truy cập trang quản trị
        </p>
    </div>

    <!-- THÔNG BÁO LỖI / THÀNH CÔNG -->
    <% if (error) { %>
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 0.85rem 1rem; border-radius: var(--radius-sm); font-size: 0.9rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <span>⚠️</span>
            <span><%= error %></span>
        </div>
    <% } %>

    <% if (success) { %>
        <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; padding: 0.85rem 1rem; border-radius: var(--radius-sm); font-size: 0.9rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
            <span>✅</span>
            <span><%= success %></span>
        </div>
    <% } %>

    <!-- FORM ĐĂNG NHẬP -->
    <form action="/login" method="POST">
        <input type="hidden" name="returnUrl" value="<%= returnUrl %>">

        <div class="form-group" style="margin-bottom: 1.25rem;">
            <label class="form-label" for="login-identifier">Email hoặc Số điện thoại</label>
            <input 
                type="text" 
                id="login-identifier" 
                name="email_or_phone" 
                class="form-control" 
                placeholder="admin@cinestar.vn hoặc 0987654321" 
                required
                autofocus
            >
        </div>

        <div class="form-group" style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <label class="form-label" for="login-password" style="margin-bottom: 0;">Mật khẩu</label>
                <a href="javascript:void(0)" onclick="togglePassword()" style="font-size: 0.75rem; color: var(--text-muted);">Hiện / Ẩn</a>
            </div>
            <input 
                type="password" 
                id="login-password" 
                name="password" 
                class="form-control" 
                placeholder="Nhập mật khẩu..." 
                required
            >
        </div>

        <button type="submit" class="nav-btn" style="width: 100%; justify-content: center; padding: 0.85rem; font-size: 1rem; border: none; cursor: pointer; margin-bottom: 1.5rem;">
            🚀 Đăng Nhập Ngay
        </button>
    </form>

    <!-- NÚT ĐIỀN NHANH PHỤC VỤ TEST / CHẤM ĐIỂM -->
    <div style="background: rgba(255, 255, 255, 0.03); border: 1px dashed var(--border-color); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem;">
        <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 0.5rem; text-align: center;">
            ⚡ Điền Nhanh Tài Khoản Mẫu (Phục Vụ Chấm Điểm)
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <button type="button" onclick="fillAdmin()" class="btn-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.5rem; text-align: center; cursor: pointer;">
                👑 Quyền Admin
            </button>
            <button type="button" onclick="fillUser()" class="btn-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.5rem; text-align: center; cursor: pointer;">
                👤 Quyền Khách Hàng
            </button>
        </div>
    </div>

    <div style="text-align: center; font-size: 0.9rem; color: var(--text-muted);">
        Chưa có tài khoản thành viên? 
        <a href="/register" style="color: var(--gold); font-weight: 600;">Đăng ký miễn phí</a>
    </div>
</div>

<script>
function togglePassword() {
    const pwd = document.getElementById('login-password');
    pwd.type = pwd.type === 'password' ? 'text' : 'password';
}

function fillAdmin() {
    document.getElementById('login-identifier').value = 'admin@cinestar.vn';
    document.getElementById('login-password').value = 'Admin@123456';
}

function fillUser() {
    document.getElementById('login-identifier').value = 'tuandat@ictu.edu.vn';
    document.getElementById('login-password').value = 'Dat@123456';
}
</script>

<%- include('partials/footer') %>
